# Credentials and Secrets
credentials/.env
credentials/services/*.json
**/.env
**/.env.*
!**/.env.example

# Debug Output
debug/

# Shell Snapshots (may contain sensitive command history)
shell-snapshots/

# TODO Lists (may contain internal company information)
todos/

# Session Notes (may contain sensitive data, company IP)
# But allow templates to be version controlled
session-notes/
**/session-notes/
!templates/session-notes/

# Project-specific tracking (kept local)
projects/

# IDE-specific files
ide/
*.local.*

# Layers (external config repos cloned here)
layers/

# macOS
.DS_Store

# Statsig local cache
statsig/

# Backup files
*.bak
*.backup
*~

# Temporary files
*.tmp
.*.swp
.*.swo

# Study logs and artifacts (may contain production data, stack traces, error messages)
study-logs/
!study-logs/.gitkeep
studies/*/artifacts/
studies/*/output/

# File history (may contain sensitive file paths and content)
file-history/
!file-history/.gitkeep

# History and conversation logs (may contain sensitive data discussed in sessions)
history.jsonl
*.history

# Any JSON files in root (often contain sensitive data exports)
/*.json
!settings.json
!/plugins/config.json

# Private Carefeed-specific documentation
private/

# Session handoff files (contain company-specific context)
SESSION_HANDOFF*.md

# Regression/incident plans (contain company-specific details)
*REGRESSION*.md
*PREVENTION_PLAN*.md

# Bootstrap logs
bootstrap.log

# Plugin state files
plugins/*.json

# MCP servers (build locally, may contain sensitive config)
mcp-servers/bin/
mcp-servers/datadog/
mcp-servers/knowledge/
mcp-servers/session-memory/
mcp-servers/shared/
mcp-servers/slack/
mcp-servers/*/dist/
mcp-servers/*/node_modules/

# Internal project plans (may contain company-specific details)
plans/

# Bin scripts for company-specific tools
bin/carefeed/

# Paste cache and task state
paste-cache/
tasks/

# Plugin caches
plugins/cache/
plugins/marketplaces/

# Transient runtime caches
cache/
checkpoints/
image-cache/
telemetry/

# Layer command/hook symlinks (auto-generated by layer_sync)
commands/_*_*.md
commands/.gitignore

# Deprecated skills (replaced by layer or removed)
skills/*.deprecated/

# Figma token cache
bin/figma_token
