#!/usr/bin/env bash
# bin/fred-mailbox-pane — Long-running loop driving the mailbox display pane.
# Launched by bin/fred inside tmux. Do not run directly.
set -u

# Ensure user PATH is available (pane starts as non-login shell)
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

export FRED_HOME="${FRED_HOME:-$HOME/.claude}"
# shellcheck disable=SC1090
source "$FRED_HOME/lib/fred/render-mailbox.sh"

# ── JSON output mode ──────────────────────────────────────────────────────────
# When called with --json, emit a structured JSON snapshot and exit.
# nostromo uses this to populate the Fred mailbox view without re-implementing
# the Graph API auth + VIP logic.
if [[ "${1:-}" == "--json" ]]; then
  export FRED_STATE="${FRED_STATE:-$FRED_HOME/state/fred}"
  mkdir -p "$FRED_STATE" 2>/dev/null || true

  # Try fresh fetch, fall back to cache
  _json_mailbox_raw() {
    if type graph_get_inbox_messages &>/dev/null; then
      local raw
      if raw=$(graph_get_inbox_messages 20 2>/dev/null) \
         && [[ -n "$raw" ]] \
         && echo "$raw" | jq -e '.value' >/dev/null 2>&1; then
        echo "$raw" > "$FRED_STATE/.mailbox.cache.json"
        echo "$raw"
        return 0
      fi
    fi
    if [[ -f "$FRED_STATE/.mailbox.cache.json" ]]; then
      cat "$FRED_STATE/.mailbox.cache.json"
      return 0
    fi
    echo '{"value":[]}'
  }

  _json_load_vips() {
    local vips_file="$FRED_STATE/vips.txt"
    [[ -f "$vips_file" ]] || return 0
    grep -v '^\s*#' "$vips_file" | grep -v '^\s*$' | tr '[:upper:]' '[:lower:]'
  }

  raw=$(_json_mailbox_raw)
  vips_blob=$(_json_load_vips)

  # Build JSON using jq — pass VIPs as a newline-separated arg
  echo "$raw" | jq --arg vips "$vips_blob" --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '
    def in_vips(email; vips_blob):
      vips_blob | split("\n") | map(select(length > 0)) | any(. == (email | ascii_downcase));

    {
      generated_at: $now,
      unread_count: ([.value[] | select(.isRead == false)] | length),
      items: [
        .value[] | {
          from: (.from.emailAddress.name // .from.emailAddress.address // "?"),
          subject: (.subject // "(no subject)"),
          received_at: (.receivedDateTime // null),
          vip: (in_vips(.from.emailAddress.address // ""; $vips)),
          is_invite: ((.["@odata.type"] // "") | test("eventMessage")),
          is_read: (.isRead // true)
        }
      ]
    }
  '
  exit $?
fi

DIRTY="$FRED_STATE/mailbox.dirty"
INTERVAL=60
LAST_RENDER=0
now=0

# Read previous unread count from state file
_read_prev_unread() {
  local f="$FRED_STATE/last-seen-unread"
  if [[ -f "$f" ]]; then
    local v
    v=$(cat "$f" 2>/dev/null | tr -d '[:space:]')
    [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" && return
  fi
  echo ""
}

# Write current unread count to state file (called AFTER rendering so the
# delta persists for one cycle, then resets on the next render).
_write_prev_unread() {
  local cache="$FRED_STATE/.mailbox.cache.json"
  [[ -f "$cache" ]] || return
  jq '[.value[] | select(.isRead==false)] | length' "$cache" 2>/dev/null \
    > "$FRED_STATE/last-seen-unread" || true
}

redraw() {
  local prev
  prev=$(_read_prev_unread)
  fred_render_mailbox "$prev"
  LAST_RENDER=$(date +%s)
  # Update last-seen-unread AFTER display so the +N delta shows for one cycle
  _write_prev_unread
}

# Resize: redraw immediately when terminal size changes
trap 'redraw' WINCH

# Initial render
redraw

while true; do
  # Poll for dirty sentinel every second; break to redraw if found
  for (( i=0; i<INTERVAL; i++ )); do
    if [[ -f "$DIRTY" ]]; then
      rm -f "$DIRTY"
      redraw
      break
    fi
    sleep 1
  done
  # Also redraw on interval even if no dirty signal arrived
  now=$(date +%s)
  if [[ $(( now - LAST_RENDER )) -ge $INTERVAL ]]; then
    redraw
  fi
done
