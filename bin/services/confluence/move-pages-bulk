#!/usr/bin/env bash
# Move multiple Confluence pages to a new parent
# Usage: move-pages-bulk <new_parent_id> <page_id1> [page_id2] [page_id3] ...
# Usage: echo "id1 id2 id3" | move-pages-bulk <new_parent_id>
# Example: move-pages-bulk 987654321 111111111 222222222 333333333
set -eo pipefail

LIB_DIR="$HOME/.claude/lib"

source "$LIB_DIR/core/credentials.sh"
source "$LIB_DIR/services/_bash/confluence.sh"

confluence_move_pages_bulk "$@"
