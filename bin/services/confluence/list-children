#!/usr/bin/env bash
# List child pages of a parent page
# Usage: list-children <parent_page_id> [limit]
# Example: list-children 123456789
# Example: list-children 123456789 50
set -eo pipefail

LIB_DIR="$HOME/.claude/lib"

source "$LIB_DIR/core/credentials.sh"
source "$LIB_DIR/services/_bash/confluence.sh"

confluence_list_children "$@"
