#!/usr/bin/env bash
# Get a Confluence page by ID
# Usage: get-page <page_id> [expand_fields]
# Example: get-page 123456789
# Example: get-page 123456789 "body.storage,version,ancestors"
set -eo pipefail

LIB_DIR="$HOME/.claude/lib"

source "$LIB_DIR/core/credentials.sh"
source "$LIB_DIR/services/_bash/confluence.sh"

confluence_get_page "$@"
