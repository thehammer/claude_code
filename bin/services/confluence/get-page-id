#!/usr/bin/env bash
# Get page ID from URL or space+title
# Usage: get-page-id <url>
# Usage: get-page-id <space_key> <title>
# Example: get-page-id "https://carefeed.atlassian.net/wiki/spaces/ENG/pages/123456789/Page+Title"
# Example: get-page-id "ENG" "My Page Title"
set -eo pipefail

LIB_DIR="$HOME/.claude/lib"

source "$LIB_DIR/core/credentials.sh"
source "$LIB_DIR/services/_bash/confluence.sh"

confluence_get_page_id "$@"
