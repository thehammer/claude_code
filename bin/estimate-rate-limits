#!/usr/bin/env python3
"""
Estimate the absolute token budget for the current Anthropic plan's
rolling rate-limit windows (5-hour and 7-day) by walking local
transcript files and back-calculating from the percentage Claude Code
reports in /tmp/.claude-rate-limits.

The estimate is necessarily a lower bound on the real budget — any work
done from other machines isn't in the local transcripts, so the local
sum is a fraction of the real total used. Multiplying by 100/pct gives
a proxy that lands somewhere between "exact" (if all work is local) and
"true budget × local-fraction".

Usage:  estimate-rate-limits

Reports raw token sum and a roughly-weighted variant using API pricing
ratios (cache reads at 0.1×, cache writes at 1.25×, output at 5×). The
real Anthropic accounting may differ — these two bracketing numbers
give a sense of the spread.
"""
import datetime as dt
import json
import os
import sys
import time
from pathlib import Path


HOME = Path.home()
PROJECTS = HOME / ".claude" / "projects"
CACHE = Path("/tmp/.claude-rate-limits")


def parse_ts(s: str) -> float:
    """Parse '2026-04-30T17:40:51.173Z' → unix seconds."""
    if not s:
        return 0.0
    s = s.rstrip("Z")
    if "." in s:
        s = s.split(".", 1)[0]
    try:
        return dt.datetime.strptime(s, "%Y-%m-%dT%H:%M:%S").replace(
            tzinfo=dt.timezone.utc
        ).timestamp()
    except ValueError:
        return 0.0


def fmt(n: int) -> str:
    return f"{n:,}"


def main() -> int:
    if not CACHE.exists():
        print("no rate-limit cache yet — let Claude Code render once first", file=sys.stderr)
        return 1
    try:
        p5, r5, p7, r7 = (int(x) for x in CACHE.read_text().strip().split(":"))
    except ValueError:
        print(f"unreadable cache: {CACHE.read_text()!r}", file=sys.stderr)
        return 1

    start_5h = r5 - 5 * 3600
    start_7d = r7 - 7 * 86400

    files = list(PROJECTS.rglob("*.jsonl"))

    totals_5h = {"in": 0, "out": 0, "cr": 0, "cw": 0, "n": 0, "models": {}}
    totals_7d = {"in": 0, "out": 0, "cr": 0, "cw": 0, "n": 0, "models": {}}

    for f in files:
        try:
            text = f.read_text(errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            usage = rec.get("usage") or rec.get("message", {}).get("usage")
            if not usage:
                continue
            ts = parse_ts(rec.get("timestamp", ""))
            if ts == 0.0:
                continue
            model = rec.get("model") or rec.get("message", {}).get("model") or "unknown"
            row = (
                int(usage.get("input_tokens") or 0),
                int(usage.get("output_tokens") or 0),
                int(usage.get("cache_read_input_tokens") or 0),
                int(usage.get("cache_creation_input_tokens") or 0),
            )

            for window, start in (("5h", start_5h), ("7d", start_7d)):
                if ts >= start:
                    t = totals_5h if window == "5h" else totals_7d
                    t["in"] += row[0]
                    t["out"] += row[1]
                    t["cr"] += row[2]
                    t["cw"] += row[3]
                    t["n"] += 1
                    t["models"][model] = t["models"].get(model, 0) + 1

    def report(label: str, t: dict, pct: int, start: int) -> None:
        raw = t["in"] + t["out"] + t["cr"] + t["cw"]
        # Weights mirror Anthropic's published API pricing ratios; this won't
        # exactly match how rate limits are scored, but it gives a sensible
        # second number to bracket the raw total.
        weighted = t["in"] + 5 * t["out"] + t["cr"] // 10 + t["cw"] * 5 // 4
        print(f"\n=== {label} ===")
        since = time.strftime("%a %b %-d %-I:%M %p", time.localtime(start))
        print(f"  window started:       {since}")
        print(f"  turns:                {fmt(t['n'])}")
        print(f"  input tokens:         {fmt(t['in'])}")
        print(f"  output tokens:        {fmt(t['out'])}")
        print(f"  cache reads:          {fmt(t['cr'])}")
        print(f"  cache writes:         {fmt(t['cw'])}")
        print(f"  total raw:            {fmt(raw)}")
        print(f"  total weighted:       {fmt(weighted)}")
        if t["models"]:
            top = sorted(t["models"].items(), key=lambda kv: -kv[1])[:5]
            print(f"  top models:           {', '.join(f'{m} ({c})' for m, c in top)}")
        print(f"  current usage %:      {pct}%")
        if pct > 0:
            print(f"  → est. budget (raw):      {fmt(raw * 100 // pct)}")
            print(f"  → est. budget (weighted): {fmt(weighted * 100 // pct)}")
        else:
            print("  budget can't be back-calculated (pct=0)")

    print(f"Scanned {fmt(len(files))} transcript files in {PROJECTS}")
    report("Last 5 hours", totals_5h, p5, start_5h)
    report("Last 7 days", totals_7d, p7, start_7d)
    print(
        "\nNote: budget estimates are LOWER BOUNDS — any usage from other "
        "machines is missing from local transcripts."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
