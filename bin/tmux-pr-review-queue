#!/usr/bin/env bash
# Format the open-PR review queue for the tmux status bar.  Reads a cache
# written by statusline-pr-review-queue-refresh and emits a tmux-colored
# "👀 N " segment, color tiered by depth so a growing queue catches the
# eye.  Hidden when there are zero PRs ready to review.

set -u

CACHE="${1:-/tmp/.claude-pr-review-queue}"
TTL=300  # 5 min — GitHub search is rate-limited and PRs don't churn that fast

if [ -f "$CACHE" ]; then
    age=$(( $(date +%s) - $(stat -f %m "$CACHE" 2>/dev/null || echo 0) ))
    if [ "$age" -ge "$TTL" ]; then
        ( "$HOME/.claude/bin/statusline-pr-review-queue-refresh" "$CACHE" >/dev/null 2>&1 ) &
    fi
    count=$(cat "$CACHE" 2>/dev/null)
else
    # First run — kick off a refresh so the next tick has data.
    ( "$HOME/.claude/bin/statusline-pr-review-queue-refresh" "$CACHE" >/dev/null 2>&1 ) &
    exit 0
fi

[ -z "$count" ] && exit 0
[ "$count" = "0" ] && exit 0

if   [ "$count" -ge 10 ]; then color="colour203"   # red — backlog forming
elif [ "$count" -ge 4 ];  then color="colour220"   # yellow — worth a look
else                            color="colour114"   # green — manageable
fi

printf '#[fg=%s]👀 %s ' "$color" "$count"
