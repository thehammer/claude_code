#!/usr/bin/env bash
# Refresh the calendar statusline cache — finds the next meeting (or one
# that just started) and writes a single line to /tmp/.claude-statusline-calendar:
#
#   STATUS|START_EPOCH|TIME_DISPLAY|SUBJECT
#
# Selection rule: events whose start time is less than 5 minutes in the
# past — i.e. anything upcoming, plus any meeting in its first 5-minute
# "active" window — sorted by start time ascending. Ties broken by response
# status preference:
#   accepted/organizer > tentativelyAccepted > notResponded/none > declined
#
# So a meeting we declined will only show if there's nothing accepted /
# tentative starting at the same time, and nothing else upcoming sooner.
# The 5-minute grace lets us keep showing the meeting we're currently
# walking into instead of jumping to the next one the instant it starts.
#
# Empty file = no upcoming meetings today. Designed for background use;
# writes via temp + rename for atomicity.

set -u

CACHE_FILE="${1:-/tmp/.claude-statusline-calendar}"
TMP_FILE="${CACHE_FILE}.tmp.$$"
LOCK_FILE="/tmp/.claude-statusline-calendar.lock"
BACKOFF_FILE="/tmp/.claude-statusline-calendar-backoff"
BACKOFF_TTL=1800  # 30 minutes — don't retry after auth failure

# If a recent auth failure was recorded, skip to avoid opening browser tabs.
if [ -f "$BACKOFF_FILE" ]; then
    _backoff_age=$(( $(date +%s) - $(stat -f %m "$BACKOFF_FILE" 2>/dev/null || echo 0) ))
    if [ "$_backoff_age" -lt "$BACKOFF_TTL" ]; then
        exit 0  # Silently skip — leave stale cache in place
    fi
fi

# Ensure only one refresh runs at a time — tmux ticks can overlap.
# Non-blocking: if the lock is held, a refresh is already in progress; skip.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    exit 0
fi

# shellcheck source=/dev/null
source "$HOME/.claude/lib/services/calendar.sh" >/dev/null 2>&1 || exit 1

today=$(date +%Y-%m-%d)
response=$(get_calendar_for_date "$today" 2>/dev/null)

# Bail on auth/API errors — leave stale cache rather than clobber.
# Write a backoff marker so we don't hammer m365 (and open browser tabs) on
# every statusline tick when the refresh token has expired.
if [ -z "$response" ] || ! echo "$response" | jq -e '.value' >/dev/null 2>&1; then
    touch "$BACKOFF_FILE"
    exit 1
fi

# Successful call — clear any existing backoff marker.
rm -f "$BACKOFF_FILE"

now_epoch=$(date +%s)
# Graph returns start.dateTime in the event's local timezone (no UTC offset).
# Compare as local-time strings — ISO 8601 sorts correctly as strings in the
# same zone. Cutoff = now minus 5-minute grace window, also as local string.
now_local=$(date '+%Y-%m-%dT%H:%M:%S')
cutoff_local=$(date -v-5M '+%Y-%m-%dT%H:%M:%S' 2>/dev/null \
               || date -d '5 minutes ago' '+%Y-%m-%dT%H:%M:%S')

selected=$(echo "$response" | jq -r --arg cutoff "$cutoff_local" '
    def clean: sub("\\.[0-9]+"; "") | sub("Z$"; "");
    def rank:
        if   . == "accepted" or . == "organizer" then 1
        elif . == "tentativelyAccepted"           then 2
        elif . == "notResponded" or . == "none"   then 3
        elif . == "declined"                      then 4
        else 5 end;
    .value
    | map({
        status:  (.responseStatus.response // "none"),
        start:   (.start.dateTime | clean),
        subject: (.subject // "(no title)")
      })
    | map(select(.start >= $cutoff))
    | sort_by(.start, (.status | rank))
    | .[0]
    | if . == null then empty
      else "\(.status)|\(.start)|\(.subject)"
      end
')

if [ -z "$selected" ]; then
    : > "$TMP_FILE"
    mv "$TMP_FILE" "$CACHE_FILE"
    exit 0
fi

IFS='|' read -r status start_local subject <<< "$selected"

# Convert local datetime string to epoch using date (timezone-aware).
epoch=$(date -j -f '%Y-%m-%dT%H:%M:%S' "$start_local" '+%s' 2>/dev/null \
        || date -d "$start_local" '+%s')
time_display=$(date -j -f '%Y-%m-%dT%H:%M:%S' "$start_local" '+%-I:%M %p' 2>/dev/null \
               || date -d "$start_local" '+%-I:%M %p')

# Pipes/newlines in the subject would corrupt the cache — flatten them.
subject_clean=$(printf '%s' "$subject" | tr '|\n\r' '   ')

printf '%s|%s|%s|%s\n' "$status" "$epoch" "$time_display" "$subject_clean" > "$TMP_FILE"

if [ -s "$TMP_FILE" ]; then
    mv "$TMP_FILE" "$CACHE_FILE"
else
    rm -f "$TMP_FILE"
    exit 1
fi
