#!/usr/bin/env bash
# bin/fred-calendar-pane — Long-running loop driving the calendar display pane.
# Launched by bin/fred inside tmux. Do not run directly.
set -u

# Ensure user PATH is available (pane starts as non-login shell)
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

export FRED_HOME="${FRED_HOME:-$HOME/.claude}"
# shellcheck disable=SC1090
source "$FRED_HOME/lib/fred/render-calendar.sh"
# shellcheck disable=SC1090
source "$FRED_HOME/lib/fred/layout.sh"

# ── JSON output mode ──────────────────────────────────────────────────────────
if [[ "${1:-}" == "--json" ]]; then
  export FRED_STATE="${FRED_STATE:-$FRED_HOME/state/fred}"
  mkdir -p "$FRED_STATE" 2>/dev/null || true

  _json_calendar_raw() {
    local today; today=$(date +%Y-%m-%d)
    if type get_calendar_for_date &>/dev/null; then
      local raw
      if raw=$(get_calendar_for_date "$today" 2>/dev/null) \
         && [[ -n "$raw" ]] \
         && echo "$raw" | jq -e '.value' >/dev/null 2>&1; then
        echo "$raw" > "$FRED_STATE/.calendar.cache.json"
        echo "$raw"
        return 0
      fi
    fi
    if [[ -f "$FRED_STATE/.calendar.cache.json" ]]; then
      cat "$FRED_STATE/.calendar.cache.json"
      return 0
    fi
    echo '{"value":[]}'
  }

  raw=$(_json_calendar_raw)
  now_epoch=$(date +%s)

  # Read sweater from state file (written by fred_apply_sweater / _fred_sweater_color)
  sweater_raw=$(cat "$FRED_STATE/.sweater" 2>/dev/null || echo "colour108")
  case "$sweater_raw" in
    *203*) sweater="red"   ;;
    *220*) sweater="amber" ;;
    *)     sweater="sage"  ;;
  esac

  echo "$raw" | jq --argjson now "$now_epoch" --arg sweater "$sweater" '
    def parse_epoch(dt):
      (dt | gsub("\\.[0-9]+$"; "") | strptime("%Y-%m-%dT%H:%M:%S") | mktime) // 0;

    def to_iso(dt):
      if dt == null or dt == "" then null
      else (dt | gsub("\\.[0-9]+$"; "") + "Z")
      end;

    (.value | sort_by(.start.dateTime)) as $sorted |
    {
      events: [
        $sorted[] |
        {
          start: to_iso(.start.dateTime),
          end:   to_iso(.end.dateTime),
          title: (.subject // "(no subject)"),
          status: (.responseStatus.response // "notResponded"),
          is_now: (
            (parse_epoch(.start.dateTime) <= $now) and
            (parse_epoch(.end.dateTime)   >  $now)
          )
        }
      ],
      next: (
        ($sorted | map(select(parse_epoch(.start.dateTime) > $now)) | first) |
        if . then {
          title: (.subject // "(no subject)"),
          in_minutes: (((parse_epoch(.start.dateTime) - $now) / 60) | floor)
        } else null end
      ),
      sweater: $sweater
    }
  '
  exit $?
fi

DIRTY="$FRED_STATE/calendar.dirty"
FETCH_INTERVAL=120   # seconds between Graph API fetches
RENDER_INTERVAL=60   # seconds between redraws (from cache)
last_fetch=0
last_render=0
now=0

redraw() {
  local now
  now=$(date +%s)
  fred_render_calendar
  fred_apply_sweater
  last_render=$now
}

fetch_and_redraw() {
  # Render triggers a fresh API fetch; cache is updated on success and kept
  # as stale fallback on failure — so don't delete it beforehand.
  redraw
  last_fetch=$(date +%s)
}

# Resize: redraw immediately
trap 'redraw' WINCH

# Initial fetch and render
fetch_and_redraw

while true; do
  # Poll for dirty sentinel every second; honor fetch and render intervals
  for (( i=0; i<RENDER_INTERVAL; i++ )); do
    if [[ -f "$DIRTY" ]]; then
      rm -f "$DIRTY"
      fetch_and_redraw
      break
    fi
    sleep 1
  done

  now=$(date +%s)
  # Time to re-fetch from API?
  if [[ $(( now - last_fetch )) -ge $FETCH_INTERVAL ]]; then
    fetch_and_redraw
  # Otherwise just redraw from cache (footer countdown updates)
  elif [[ $(( now - last_render )) -ge $RENDER_INTERVAL ]]; then
    redraw
  fi
done
