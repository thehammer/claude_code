#!/bin/bash
# Index Claude Code sessions
# Generates a searchable index of all sessions with metadata
#
# Usage:
#   index-sessions              # Display table of all sessions
#   index-sessions json         # Output as JSON array
#   index-sessions csv          # Output as CSV
#   index-sessions search TERM  # Search sessions by summary/project
#   index-sessions recent [N]   # Show N most recent sessions (default 10)
#   index-sessions project NAME # Filter by project name
#   index-sessions rebuild      # Rebuild the cached JSON index

set -euo pipefail

PROJECTS_DIR="${HOME}/.claude/projects"
INDEX_CACHE="${HOME}/.claude/sessions-index.json"
OUTPUT_FORMAT="${1:-table}"  # table, json, csv, search, recent, project, rebuild

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

build_index() {
    local output_file="$1"
    local sessions=()

    for project_dir in "$PROJECTS_DIR"/*/; do
        [ -d "$project_dir" ] || continue
        local project=$(basename "$project_dir")

        for session_file in "$project_dir"*.jsonl; do
            [ -f "$session_file" ] || continue

            local session_id=$(basename "$session_file" .jsonl)
            local size=$(stat -f%z "$session_file" 2>/dev/null || echo "0")
            local size_kb=$((size / 1024))
            local modified=$(stat -f "%Sm" -t "%Y-%m-%dT%H:%M:%S" "$session_file" 2>/dev/null || echo "")
            local summary=$(head -1 "$session_file" | jq -r '.summary // empty' 2>/dev/null)
            local first_timestamp=$(grep -m1 '"type":"user"' "$session_file" 2>/dev/null | jq -r '.timestamp // empty' 2>/dev/null)
            local user_count=$(grep -c '"type":"user"' "$session_file" 2>/dev/null) || user_count=0
            local assistant_count=$(grep -c '"type":"assistant"' "$session_file" 2>/dev/null) || assistant_count=0
            # Ensure counts are numeric
            user_count=${user_count:-0}
            assistant_count=${assistant_count:-0}
            local session_type="main"
            [[ "$session_id" == agent-* ]] && session_type="agent"

            sessions+=("$(jq -n \
                --arg id "$session_id" \
                --arg project "$project" \
                --arg summary "$summary" \
                --arg start "$first_timestamp" \
                --arg modified "$modified" \
                --arg type "$session_type" \
                --arg file "$session_file" \
                --argjson size_kb "$size_kb" \
                --argjson user_msgs "$user_count" \
                --argjson assistant_msgs "$assistant_count" \
                '{id: $id, project: $project, summary: $summary, start: $start, modified: $modified, type: $type, file: $file, size_kb: $size_kb, user_messages: $user_msgs, assistant_messages: $assistant_msgs}')")
        done
    done

    printf '%s\n' "${sessions[@]}" | jq -s 'sort_by(.modified) | reverse' > "$output_file"
    echo -e "${GREEN}Index rebuilt:${NC} $(jq length "$output_file") sessions cached to $output_file" >&2
}

ensure_index() {
    # Rebuild if cache doesn't exist or is older than 1 hour
    if [ ! -f "$INDEX_CACHE" ] || [ $(find "$INDEX_CACHE" -mmin +60 2>/dev/null | wc -l) -gt 0 ]; then
        build_index "$INDEX_CACHE"
    fi
}

display_table() {
    local data="$1"
    echo -e "${BLUE}Claude Code Session Index${NC}"
    echo "========================="
    echo ""
    printf "%-12s  %-22s  %-10s  %8s  %10s  %s\n" "SESSION" "PROJECT" "DATE" "SIZE" "MSGS(U/A)" "SUMMARY"
    echo "-----------------------------------------------------------------------------------------------------------"

    echo "$data" | jq -r '.[] | [.id[0:12], .project[0:22], (.start[0:10] // "N/A"), "\(.size_kb)KB", "\(.user_messages)/\(.assistant_messages)", .summary[0:45]] | @tsv' | while IFS=$'\t' read -r id proj date size msgs summary; do
        printf "%-12s  %-22s  %-10s  %8s  %10s  %s\n" "$id" "$proj" "$date" "$size" "$msgs" "$summary"
    done

    local total=$(echo "$data" | jq length)
    local total_size=$(echo "$data" | jq '[.[].size_kb] | add // 0')
    echo ""
    echo "-----------------------------------------------------------------------------------------------------------"
    echo -e "Total: ${GREEN}$total sessions${NC}, ${YELLOW}$((total_size / 1024))MB${NC}"
}

search_sessions() {
    local term="$1"
    ensure_index
    local results=$(jq --arg term "$term" '[.[] | select((.summary | ascii_downcase | contains($term | ascii_downcase)) or (.project | ascii_downcase | contains($term | ascii_downcase)))]' "$INDEX_CACHE")
    local count=$(echo "$results" | jq length)
    echo -e "${BLUE}Search results for '${term}':${NC} $count matches"
    echo ""
    display_table "$results"
}

recent_sessions() {
    local count="${1:-10}"
    ensure_index
    local results=$(jq --argjson n "$count" '.[:$n]' "$INDEX_CACHE")
    echo -e "${BLUE}$count Most Recent Sessions${NC}"
    display_table "$results"
}

filter_project() {
    local project_filter="$1"
    ensure_index
    local results=$(jq --arg p "$project_filter" '[.[] | select(.project | ascii_downcase | contains($p | ascii_downcase))]' "$INDEX_CACHE")
    display_table "$results"
}

main() {
    case "$OUTPUT_FORMAT" in
        rebuild)
            build_index "$INDEX_CACHE"
            ;;
        search)
            search_sessions "${2:-}"
            ;;
        recent)
            recent_sessions "${2:-10}"
            ;;
        project)
            filter_project "${2:-}"
            ;;
        json)
            ensure_index
            cat "$INDEX_CACHE"
            ;;
        csv)
            ensure_index
            echo "session_id,project,summary,start,modified,type,size_kb,user_messages,assistant_messages"
            jq -r '.[] | [.id, .project, .summary, .start, .modified, .type, .size_kb, .user_messages, .assistant_messages] | @csv' "$INDEX_CACHE"
            ;;
        *)
            ensure_index
            display_table "$(cat "$INDEX_CACHE")"
            ;;
    esac
}

main "$@"
