#!/bin/bash
# IDE Command Center CLI
# Provides command-line interface to the session registry and IDE functions
#
# Usage: ide <command> [args...]
#
# Commands:
#   register <type> [project] [description]  - Register a new session
#   deregister [session_id]                  - Remove a session from registry
#   status <status> [session_id]             - Update session status (running/waiting/idle)
#   list [format]                            - List sessions (json/table/ids)
#   get [session_id]                         - Get session details
#   count                                    - Count active sessions
#   cleanup                                  - Remove stale sessions
#   dashboard                                - Launch interactive dashboard
#   help                                     - Show this help

set -e

# Source the core IDE libraries
source "$HOME/.claude/lib/core/ide.sh"
source "$HOME/.claude/lib/core/worktree.sh" 2>/dev/null || true
source "$HOME/.claude/lib/core/locks.sh" 2>/dev/null || true

# Show help
show_help() {
    cat << 'EOF'
IDE Command Center CLI

Usage: ide <command> [args...]

Session Management:
  register <type> [project] [description]  Register current pane as a session
  deregister [session_id]                  Remove session from registry
  status <status> [session_id]             Update status (running/waiting/idle)
  update <field> <value> [session_id]      Update any session field

Query Commands:
  list [format]                            List sessions (json/table/ids)
  get [session_id]                         Get full session details
  count                                    Count active sessions
  find <field> <value>                     Find sessions by field value
  waiting                                  List sessions waiting for input

Worktree Commands:
  worktree list [format]                   List all worktrees (json/table/paths)
  worktree create <branch> [--new]         Create worktree for branch
  worktree remove <branch> [--force]       Remove worktree
  worktree path <branch>                   Get path for branch worktree
  worktree setup <branch> [--new]          Create, install deps, show path

Lock Commands:
  lock list [format]                       List active locks (json/table)
  lock acquire <name> [timeout] [desc]     Acquire a lock (timeout: 0=no wait, -1=forever)
  lock release <name> [--force]            Release a lock
  lock check <name>                        Check if lock is held (exit 0=held, 1=free)
  lock holder <name>                       Show who holds a lock
  lock exec <name> <command...>            Run command while holding lock

History:
  history [limit] [format]                 Show recent sessions (json/table)
  history clear [keep]                     Clear history, optionally keep last N

Maintenance:
  cleanup                                  Remove stale sessions and locks

Dashboard:
  dashboard                                Launch interactive dashboard
  switch                                   Quick session switcher (popup)

Examples:
  ide register coding /path/to/project "implementing auth"
  ide status waiting
  ide list table
  ide worktree create feature/auth
  ide worktree setup feature/new-thing --new
  ide lock acquire myproject:tests 0 "running unit tests"
  ide lock exec myproject:db php artisan migrate
  ide lock list
  ide cleanup
EOF
}

# Main command dispatcher
main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        register)
            local type="${1:-coding}"
            local project="${2:-$(pwd)}"
            local description="${3:-}"
            ide_register_session "$type" "$project" "$description"
            ;;

        deregister|dereg|remove)
            ide_deregister_session "$1"
            ;;

        status)
            if [[ -z "$1" ]]; then
                echo "Error: Status required (running/waiting/idle)" >&2
                exit 1
            fi
            ide_update_status "$1" "$2"
            ;;

        update)
            if [[ -z "$1" || -z "$2" ]]; then
                echo "Error: Field and value required" >&2
                exit 1
            fi
            ide_update_field "$1" "$2" "$3"
            ;;

        list|ls)
            ide_list_sessions "${1:-table}"
            ;;

        get)
            ide_get_session "$1" | jq .
            ;;

        count)
            ide_count_sessions
            ;;

        find)
            if [[ -z "$1" || -z "$2" ]]; then
                echo "Error: Field and value required" >&2
                exit 1
            fi
            ide_find_sessions "$1" "$2" | jq .
            ;;

        waiting)
            ide_get_waiting_sessions | jq .
            ;;

        cleanup)
            echo "Cleaning up stale sessions..."
            local sessions_cleaned=$(ide_cleanup_stale_sessions)
            echo "Cleaned up $sessions_cleaned stale session(s)"
            echo "Cleaning up stale locks..."
            local locks_cleaned=$(lock_cleanup_stale)
            echo "Cleaned up $locks_cleaned stale lock(s)"
            ;;

        statusline)
            ide_get_status_line "$1"
            ;;

        dashboard)
            exec "$HOME/.claude/bin/ide-dashboard"
            ;;

        switch|sw)
            # Quick switcher - run as popup if in tmux, otherwise direct
            if [[ -n "$TMUX" && "$1" != "--direct" ]]; then
                exec tmux display-popup -w 45% -h 50% -E "$HOME/.claude/bin/ide-switcher"
            else
                exec "$HOME/.claude/bin/ide-switcher"
            fi
            ;;

        worktree|wt)
            local wt_cmd="${1:-list}"
            shift || true

            case "$wt_cmd" in
                list|ls)
                    worktree_list "${1:-table}"
                    ;;
                create)
                    local branch="$1"
                    local create_new="false"
                    [[ "$2" == "--new" || "$2" == "-n" ]] && create_new="true"
                    if [[ -z "$branch" ]]; then
                        echo "Error: Branch name required" >&2
                        exit 1
                    fi
                    worktree_create "$branch" "$create_new"
                    ;;
                remove|rm)
                    local branch="$1"
                    local force="false"
                    [[ "$2" == "--force" || "$2" == "-f" ]] && force="true"
                    if [[ -z "$branch" ]]; then
                        echo "Error: Branch name required" >&2
                        exit 1
                    fi
                    worktree_remove "$branch" "$force"
                    ;;
                path)
                    if [[ -z "$1" ]]; then
                        echo "Error: Branch name required" >&2
                        exit 1
                    fi
                    worktree_get_path "$1"
                    ;;
                setup)
                    local branch="$1"
                    local create_new="false"
                    [[ "$2" == "--new" || "$2" == "-n" ]] && create_new="true"
                    if [[ -z "$branch" ]]; then
                        echo "Error: Branch name required" >&2
                        exit 1
                    fi
                    worktree_setup "$branch" "$create_new"
                    ;;
                prune)
                    worktree_prune
                    ;;
                type)
                    worktree_get_type
                    ;;
                branch)
                    worktree_get_branch
                    ;;
                *)
                    echo "Unknown worktree command: $wt_cmd" >&2
                    echo "Try: ide worktree list" >&2
                    exit 1
                    ;;
            esac
            ;;

        lock)
            local lock_cmd="${1:-list}"
            shift || true

            case "$lock_cmd" in
                list|ls)
                    lock_list "${1:-table}"
                    ;;
                acquire|get)
                    local lock_name="$1"
                    local timeout="${2:-0}"
                    local description="${3:-}"
                    if [[ -z "$lock_name" ]]; then
                        echo "Error: Lock name required" >&2
                        exit 1
                    fi
                    if lock_acquire "$lock_name" "$timeout" "$description"; then
                        echo "Acquired lock: $lock_name"
                    else
                        echo "Failed to acquire lock: $lock_name" >&2
                        lock_holder "$lock_name" | jq -r '"  Held by: session \(.session_id) (window \(.tmux_window // "?"))"' 2>/dev/null
                        exit 1
                    fi
                    ;;
                release|free)
                    local lock_name="$1"
                    local force="false"
                    [[ "$2" == "--force" || "$2" == "-f" ]] && force="true"
                    if [[ -z "$lock_name" ]]; then
                        echo "Error: Lock name required" >&2
                        exit 1
                    fi
                    if lock_release "$lock_name" "$force"; then
                        echo "Released lock: $lock_name"
                    else
                        exit 1
                    fi
                    ;;
                check)
                    local lock_name="$1"
                    if [[ -z "$lock_name" ]]; then
                        echo "Error: Lock name required" >&2
                        exit 1
                    fi
                    if lock_is_held "$lock_name"; then
                        echo "Lock '$lock_name' is held"
                        exit 0
                    else
                        echo "Lock '$lock_name' is free"
                        exit 1
                    fi
                    ;;
                holder|who)
                    local lock_name="$1"
                    if [[ -z "$lock_name" ]]; then
                        echo "Error: Lock name required" >&2
                        exit 1
                    fi
                    local holder=$(lock_holder "$lock_name")
                    if [[ -n "$holder" ]]; then
                        echo "$holder" | jq .
                    else
                        echo "Lock '$lock_name' is not held"
                        exit 1
                    fi
                    ;;
                exec|run)
                    local lock_name="$1"
                    shift || true
                    if [[ -z "$lock_name" ]]; then
                        echo "Error: Lock name required" >&2
                        exit 1
                    fi
                    if [[ -z "$1" ]]; then
                        echo "Error: Command required" >&2
                        exit 1
                    fi
                    lock_exec "$lock_name" "$@"
                    ;;
                cleanup)
                    echo "Cleaning up stale locks..."
                    local cleaned=$(lock_cleanup_stale)
                    echo "Cleaned up $cleaned stale lock(s)"
                    ;;
                *)
                    echo "Unknown lock command: $lock_cmd" >&2
                    echo "Try: ide lock list" >&2
                    exit 1
                    ;;
            esac
            ;;

        history|hist)
            local hist_cmd="${1:-show}"
            shift || true

            case "$hist_cmd" in
                show|[0-9]*)
                    # Allow 'ide history 20' as shorthand
                    local limit="$hist_cmd"
                    [[ "$hist_cmd" == "show" ]] && limit="${1:-10}"
                    local format="${2:-table}"
                    [[ "$hist_cmd" != "show" ]] && format="${1:-table}"
                    ide_get_history "$limit" "$format"
                    ;;
                clear)
                    local keep="${1:-100}"
                    ide_clear_history "$keep"
                    echo "History cleared (kept last $keep entries)"
                    ;;
                *)
                    echo "Unknown history command: $hist_cmd" >&2
                    echo "Try: ide history 10" >&2
                    exit 1
                    ;;
            esac
            ;;

        help|--help|-h)
            show_help
            ;;

        *)
            echo "Unknown command: $cmd" >&2
            echo "Run 'ide help' for usage" >&2
            exit 1
            ;;
    esac
}

main "$@"
