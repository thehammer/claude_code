# Claude Code Credentials Template
# =================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# This file (.env.example) is safe to commit as it contains no secrets.

# =============================================================================
# ATLASSIAN (Required for Jira & Bitbucket MCP servers)
# =============================================================================

# Your Atlassian site (e.g., mycompany.atlassian.net)
ATLASSIAN_SITE_NAME=your-site.atlassian.net

# Your Atlassian account email
ATLASSIAN_USER_EMAIL=your-email@company.com

# API Token from: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# =============================================================================
# BITBUCKET
# =============================================================================

# Default workspace for Bitbucket operations
BITBUCKET_DEFAULT_WORKSPACE=your-workspace

# =============================================================================
# GITHUB (Optional - for GitHub integration)
# =============================================================================

# Personal Access Token from: https://github.com/settings/tokens
# Scopes needed: repo, read:org
GITHUB_TOKEN=

# Default organization (optional)
GITHUB_ORG=

# =============================================================================
# SLACK (Optional - for Slack integration)
# =============================================================================

# Bot token from: https://api.slack.com/apps → Your App → OAuth & Permissions
# Scopes needed: chat:write, channels:read, users:read
SLACK_BOT_TOKEN=

# User token (for user-context operations like reading channels)
# Get from: OAuth & Permissions → User Token Scopes
SLACK_USER_TOKEN=

# =============================================================================
# DATADOG (Optional - for log search and monitoring)
# =============================================================================

# API Key from: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=

# Application Key from: https://app.datadoghq.com/organization-settings/application-keys
DATADOG_APP_KEY=

# Datadog site (e.g., datadoghq.com, datadoghq.eu)
DATADOG_SITE=datadoghq.com

# =============================================================================
# SENTRY (Optional - for error tracking)
# =============================================================================

# Auth Token from: https://sentry.io/settings/account/api/auth-tokens/
# Scopes needed: project:read, event:read, org:read
SENTRY_AUTH_TOKEN=

# Your Sentry organization slug
SENTRY_ORG=

# =============================================================================
# AWS (Optional - for AWS integrations)
# =============================================================================

# AWS credentials (or use ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# 1PASSWORD (Optional - for secrets management)
# =============================================================================

# Service Account Token from: https://my.1password.com/developer-tools/service-accounts
OP_SERVICE_ACCOUNT_TOKEN=

# =============================================================================
# OPENAI (Optional - for embeddings or other OpenAI features)
# =============================================================================

OPENAI_API_KEY=

# =============================================================================
# ANTHROPIC (Usually not needed - Claude Code uses its own auth)
# =============================================================================

# Only needed if using Anthropic API directly from scripts
ANTHROPIC_API_KEY=
