{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Bash(~/.claude/lib/*.sh:*)",
      "Bash(aws sso login:*)",
      "Bash(aws_:*)",
      "Bash(AWS_:*)",
      "Bash(carefeed_:*)",
      "Bash(datadog_:*)",
      "Bash(extract_:*)",
      "Bash(get_:*)",
      "Bash(github_:*)",
      "Bash(infer_:*)",
      "Bash(is_:*)",
      "Bash(jira_:*)",
      "Bash(m365:*)",
      "Bash(mv:*)",
      "Bash(op_:*)",
      "Bash(sentry_:*)",
      "Bash(show_:*)",
      "Bash(slack_:*)",
      "Bash(validate_:*)",
      "Bash(vscode_:*)",
      "Edit(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(dd_:*)",
      "Bash(sessions_:*)",
      "Read(//**)",
      "WebFetch(domain:**)",
      "WebSearch",
      "Write(**)",
      "Bash(gh pr create:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(DROP DATABASE:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(mv /dev/null:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(su:*)",
      "Bash(sudo /dev/null:*)",
      "Bash(sudo rm:*)",
      "Bash(sudo rmdir:*)"
    ]
  },
  "model": "sonnet[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/doc-file-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/typescript-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/console-log-warning.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/inject-time.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "mother@thehammer-mother": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "thehammer-mother": {
      "source": {
        "source": "github",
        "repo": "thehammer/mother"
      }
    }
  },
  "viewMode": "focus",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
