{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Bash(~/.claude/lib/*.sh:*)",
      "Bash(aws_:*)",
      "Bash(AWS_:*)",
      "Bash(carefeed_:*)",
      "Bash(datadog_:*)",
      "Bash(extract_:*)",
      "Bash(get_:*)",
      "Bash(github_:*)",
      "Bash(infer_:*)",
      "Bash(is_:*)",
      "Bash(jira_:*)",
      "Bash(m365:*)",
      "Bash(mv:*)",
      "Bash(op_:*)",
      "Bash(sentry_:*)",
      "Bash(show_:*)",
      "Bash(slack_:*)",
      "Bash(validate_:*)",
      "Bash(vscode_:*)",
      "Edit(**)",
      "Glob(**)",
      "Grep(**)",
      "mcp__jira__jira_add_comment",
      "mcp__jira__jira_create_issue",
      "mcp__jira__jira_get_create_meta",
      "mcp__jira__jira_get_issue",
      "mcp__jira__jira_get_project",
      "mcp__jira__jira_get_transitions",
      "mcp__jira__jira_ls_issues",
      "mcp__jira__jira_ls_projects",
      "mcp__jira__jira_transition_issue",
      "mcp__session-memory__search_sessions",
      "mcp__session-memory__list_sessions",
      "mcp__session-memory__get_session",
      "mcp__session-memory__index_sessions",
      "mcp__datadog__datadog_validate",
      "mcp__datadog__datadog_search_logs",
      "mcp__datadog__datadog_logs_from_slack",
      "mcp__datadog__datadog_query_metrics",
      "mcp__datadog__datadog_list_monitors",
      "mcp__datadog__datadog_get_monitor",
      "mcp__datadog__datadog_search_traces",
      "mcp__datadog__datadog_service_stats",
      "mcp__datadog__datadog_resource_stats",
      "Read(//**)",
      "WebFetch(domain:**)",
      "WebSearch",
      "Write(**)"
    ],
    "deny": [
      "Bash(DROP DATABASE:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push:*)",
      "Bash(mv /dev/null:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(su:*)",
      "Bash(sudo /dev/null:*)",
      "Bash(sudo rm:*)",
      "Bash(sudo rmdir:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/workspace-lock.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/doc-file-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/typescript-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/console-log-warning.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "mcpServers": {
    "jira": {
      "type": "http",
      "url": "http://localhost:3000/mcp"
    },
    "session-memory": {
      "type": "http",
      "url": "http://localhost:3002/mcp"
    },
    "datadog": {
      "type": "http",
      "url": "http://localhost:3004/mcp"
    }
  },
  "skipDangerousModePermissionPrompt": true
}
