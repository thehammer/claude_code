{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "mother@thehammer-mother": true,
    "php-lsp@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "teri@thehammer-teri": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "thehammer-mother": {
      "source": {
        "repo": "thehammer/mother",
        "source": "github"
      }
    },
    "thehammer-teri": {
      "source": {
        "path": "/Users/hammer/Code/teri",
        "source": "directory"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/typescript-check.sh",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/console-log-warning.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "/Users/hammer/.cargo/bin/nostromo-activity-hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/doc-file-guard.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/layers/carefeed/hooks/people-registry-hint.sh",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/Users/hammer/.cargo/bin/nostromo-activity-hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Users/hammer/.cargo/bin/nostromo-activity-hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/inject-time.sh",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(~/.claude/lib/*.sh:*)",
      "Bash(aws sso login:*)",
      "Bash(aws_:*)",
      "Bash(AWS_:*)",
      "Bash(carefeed_:*)",
      "Bash(datadog_:*)",
      "Bash(extract_:*)",
      "Bash(get_:*)",
      "Bash(github_:*)",
      "Bash(infer_:*)",
      "Bash(is_:*)",
      "Bash(jira_:*)",
      "Bash(m365:*)",
      "Bash(mv:*)",
      "Bash(op_:*)",
      "Bash(sentry_:*)",
      "Bash(show_:*)",
      "Bash(slack_:*)",
      "Bash(validate_:*)",
      "Bash(vscode_:*)",
      "Edit(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(dd_:*)",
      "Bash(sessions_:*)",
      "Read(//**)",
      "WebFetch(domain:**)",
      "WebSearch",
      "Write(**)",
      "Bash(gh pr create:*)",
      "Bash(gh pr review:*)",
      "Bash(rm -f ~/.claude/state/**:*)",
      "Bash(rm -f /tmp/*:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(mv /dev/null:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(su:*)",
      "Bash(sudo /dev/null:*)",
      "Bash(sudo rm:*)",
      "Bash(sudo rmdir:*)"
    ],
    "deny": [
      "Bash(DROP DATABASE:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)"
    ]
  },
  "skillOverrides": {
    "fusionauth-setup": "off",
    "m365-setup": "off",
    "staging-monitor-db": "off",
    "teams": "off",
    "terraform": "off"
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "viewMode": "focus"
}
